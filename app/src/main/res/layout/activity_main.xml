<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Purple header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/purple_primary"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/explore_heading"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/explore_subheading"
            android:textColor="@color/purple_pale"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/gold_accent"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="@string/sample_data_label"
            android:textColor="@color/black"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Venue cards are added into venueContainer from MainActivity.java -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/venueContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </ScrollView>

    <!-- Bottom bar: Explore | My Bookings | Profile -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabExplore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:drawableTop="@android:drawable/ic_menu_search"
            android:drawableTint="@color/purple_primary"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/tab_explore"
            android:textColor="@color/purple_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabBookings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:drawableTop="@android:drawable/ic_menu_agenda"
            android:drawableTint="@color/tab_inactive"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/tab_bookings"
            android:textColor="@color/tab_inactive" />

        <TextView
            android:id="@+id/tabProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:drawableTop="@android:drawable/ic_menu_myplaces"
            android:drawableTint="@color/tab_inactive"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/tab_profile"
            android:textColor="@color/tab_inactive" />
    </LinearLayout>

</LinearLayout>
