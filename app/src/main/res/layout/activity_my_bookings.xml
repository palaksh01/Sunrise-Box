<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Upcoming / Past toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/purple_primary"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnUpcoming"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/btn_upcoming" />

        <Button
            android:id="@+id/btnPast"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/btn_past" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTapHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:text="@string/tap_hint_upcoming"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="italic" />

    <!-- Shown only when the selected list is empty -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/no_upcoming"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lvBookings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/purple_pale"
        android:dividerHeight="8dp"
        android:padding="16dp" />

    <!-- Bottom bar: Explore | My Bookings | Profile -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabExplore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:drawableTop="@android:drawable/ic_menu_search"
            android:drawableTint="@color/tab_inactive"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/tab_explore"
            android:textColor="@color/tab_inactive" />

        <TextView
            android:id="@+id/tabBookings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:drawableTop="@android:drawable/ic_menu_agenda"
            android:drawableTint="@color/purple_primary"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/tab_bookings"
            android:textColor="@color/purple_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:drawableTop="@android:drawable/ic_menu_myplaces"
            android:drawableTint="@color/tab_inactive"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/tab_profile"
            android:textColor="@color/tab_inactive" />
    </LinearLayout>

</LinearLayout>
